{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build:web)",
      "Bash(npm run preview:web)",
      "Bash(npm run web)",
      "Bash(npm run ai-logs *)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy:preview)",
      "Bash(npx expo install *)",
      "Bash(npx expo export *)",
      "Bash(npx expo start *)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  }
}
