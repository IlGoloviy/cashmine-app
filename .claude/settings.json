{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm test)",
      "Bash(npm test -- --ci)",
      "Bash(npm run build:web)",
      "Bash(npm run preview:web)",
      "Bash(npm run web)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy:preview)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git log --oneline)",
      "Bash(git log --oneline -5)",
      "Bash(git log --oneline -10)",
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git commit -m *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(gh run list)",
      "Bash(gh run list -L 1)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Bash(cat *.env*)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(grep * .env*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  }
}
