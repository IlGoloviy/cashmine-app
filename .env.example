# Copy to .env.local (gitignored) and fill in from the task email.
# NOTE: every EXPO_PUBLIC_* value is inlined into the JS bundle. Fine for a test token,
# never for a production secret.
EXPO_PUBLIC_API_URL=https://api.example.com
# Not read by the app (the token is entered in the UI). Kept here only so
# `npm run ai-logs` can redact it from exported conversations.
EXPO_PUBLIC_API_TOKEN=
